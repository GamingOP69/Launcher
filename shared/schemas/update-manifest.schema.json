{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SamratUpdateManifest",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "releaseDate": { "type": "string" },
    "channel": { "type": "string", "enum": ["stable", "beta", "nightly"] },
    "minLauncherVersion": { "type": "string" },
    "changelog": {
      "type": "array",
      "items": { "type": "string" }
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "clientJar": {
          "type": "object",
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
            "sizeBytes": { "type": "integer" }
          },
          "required": ["url", "sha256", "sizeBytes"]
        },
        "launcherInstaller": {
          "type": "object",
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
            "sizeBytes": { "type": "integer" }
          },
          "required": ["url", "sha256", "sizeBytes"]
        }
      },
      "required": ["clientJar", "launcherInstaller"]
    }
  },
  "required": ["version", "releaseDate", "channel", "artifacts"]
}
