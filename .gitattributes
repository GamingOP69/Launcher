# Auto detect text files and perform LF normalization
* text=auto

# Linux / Unix shell scripts and wrappers must strictly use LF
gradlew text eol=lf
*.sh text eol=lf

# Windows batch files must strictly use CRLF
gradlew.bat text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Source Code
*.java text eol=lf diff=java
*.rs text eol=lf diff=rust
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf

# Binaries (must not be modified or normalized)
*.jar binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.icns binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.zip binary
*.tar.gz binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
